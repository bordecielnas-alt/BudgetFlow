# Toutes les variables sont optionnelles.

# Port d'écoute et dossier des données persistantes
# PORT=3000
# DATA_DIR=./data

# Compte administrateur créé au premier démarrage (changez-le ensuite dans Réglages → Compte)
# ADMIN_EMAIL=admin@budget.local
# ADMIN_PASSWORD=

# Clés des fournisseurs d'IA. Une clé saisie dans Réglages → IA est prioritaire.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
